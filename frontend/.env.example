# Required on Vercel. Existing Flask or future FastAPI deployment. No trailing slash.
ATHAR_API_ORIGIN=http://127.0.0.1:5001

# Required on Vercel. Flask pages that have not moved to Next.js yet (ASR, editor).
NEXT_PUBLIC_LEGACY_APP_ORIGIN=http://127.0.0.1:5001

# Required on Vercel. Canonical URL used by metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
