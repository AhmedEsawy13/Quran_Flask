supabase/.temp/

# Generated / large data files — do not commit
QUL_data/quran_script.backup_*.db
QUL_data/Tafseer*.json
reciters/husary/word_alignment.json
# DB backups/snapshots — kept locally only, never committed
data/*.backup_*.db
data/*.backup*.db

# Local font-renderer experiment artifacts — do not commit
/tmp/
/artifacts/
static/VisualMetaFontWasm.js
static/VisualMetaFontWasm.wasm
static/hb.js
static/hb.wasm
static/automedina.fea
static/ayah.mp
static/digitalkhatt.mp
static/medinapages.dat
static/mfplain.mp
static/mpguifont.mp
static/myfontbase.mp
static/parameters.json
static/texpages.dat
static/asr_model.q8.onnx
static/asr/asr_model.q8.onnx
tokenizer.model
streaming_global_cmvn.npz

# Recitation (تسميع) feature — the JS is shipped (used by /waqf-practice), but
# the model binaries stay local. Ignore the folder CONTENTS (not the dir) so the
# tiny derived config below can be negated back in.
static/asr/*
static/asr_test.html

# SQLite transient files (WAL/SHM) created by the running server
*.db-shm
*.db-wal

# QUL reciter timestamps: 52 MB refreshed weekly upstream — NOT tracked.
# Restored at the pinned release by `import_qul_reciters.py --restore`
# (Heroku bin/post_compile runs it on every build; run it after fresh clones).
reciters/**/word_timestamps.json.gz
reciters/**/verse_timestamps.json.gz
reciters/**/letter_timestamps.json.gz

# Zipformer phoneme ASR: ship the tiny derived config, keep the 73MB model + gated
# source jsons (phoneme_units/quran_text2phoneme) local.
!static/asr/zipformer_meta.json
!static/asr/zipformer_phonemes.json

# QUL tafsir SQLite exports (~65MB total) — one-time input to
# pipeline/build_tafseer_local.py, requires a QUL account to re-download.
# The BUILT data/tafseer_local.db is what ships, this raw source isn't.
pipeline/tafseer_source/

# Classical waqf AI re-extraction (pipeline/build_classical_llm.py):
# the per-surah extraction JSONs in classical_llm_cache/ ARE the deliverable
# (hand-verified, or model output) and are tracked; the built db is regenerable
# from them, so only it is ignored.
data/classical_waqf_llm.db
# Local scholarly decisions made in /classical-review. The review UI creates
# this on first write; decisions are exported/reviewed before release rather
# than silently committed as a mutable binary database.
data/classical_review.db
data/mesaha-ocr/

# OpenCV waqf detection — local caches / crops / scratch (models/*.onnx is tracked)
data/cv/pages/
data/cv/crops/
data/cv/crops_labeled/
data/cv/crops_hand/
data/cv/word_boxes_mesaha.sqlite
data/cv/overlays/
.venv-cv/
artifacts/cv-waqf/
models/backup/
models/*.hand.onnx
data/bahrain-digital-khatt.db
