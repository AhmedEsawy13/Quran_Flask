{
    "version": 2,
    "builds": [
      {
        "src": "app.py",
        "use": "@vercel/python",
        "config": {
          "maxLambdaSize": "250mb",
          "excludeFiles": "{reciters/**/letter_timestamps.json.gz,reciters/**/verse_timestamps.json.gz,reciters/husary/transitions.db,reciters/husary/transitions_v0.db,reciters/husary/positions_v0.db}"
        }
      }
    ],
    "rewrites": [
      {
        "source": "/(.*)",
        "destination": "app.py"
      }
    ],
    "env": {
      "FLASK_ENV": "production"
    },
    "headers": [
      {
        "source": "/api/(.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, s-maxage=3600"
          }
        ]
      },
      {
        "source": "/static/(.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }